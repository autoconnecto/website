# Copy to `.env` for local dev. Production CI should set this variable before `npm run build`.

# Required for correct sitemap.xml, robots.txt, canonical URLs, and Open Graph at `next build`.
# Use the hostname you want Google to treat as primary (www or apex — pick one).
NEXT_PUBLIC_SITE_URL=https://www.autoconnecto.in

# Public API for live plan catalog on /pricing (defaults to production API).
# NEXT_PUBLIC_API_URL=https://api.autoconnecto.in

# Optional — Google Search Console HTML tag content only.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional — POST JSON leads here (Zapier / Make / your API). If unset, forms open mailto with pre-filled body.
# NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Optional — mailto recipient when webhook is unset (defaults to founder@autoconnecto.in).
# NEXT_PUBLIC_LEADS_EMAIL=
